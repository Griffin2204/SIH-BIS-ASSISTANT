# =================================================================
# Production & Deployment Environment Configuration Example
# Copy this file to .env and configure for your environment.
# NEVER commit .env with real secrets to version control.
# =================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development  # Set to "production" in production deployments

# Persistent Storage Directories (Use volume mount path in production)
UPLOAD_DIR=./documents/uploads
CHROMA_PERSIST_DIRECTORY=./vector_store
CHROMA_COLLECTION_NAME=bis_documents_multilingual

# CORS Configuration
# Comma-separated list of allowed origins. In production, never use wildcard (*).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting Configuration (In-Memory Sliding Window)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# LLM Configuration (Google Gemini or OpenAI)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your_api_key_here

# Embedding & Multilingual Configuration
MULTILINGUAL_ENABLED=true
MULTILINGUAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
